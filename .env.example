# Keystatic storage mode.
# Unset (or anything but "cloud") = local mode: edits write to files on disk.
# "cloud" = Keystatic Cloud: the client edits the live site, no GitHub account
# needed. Requires CLOUD_PROJECT to be set in keystatic.config.ts.
#
# Must keep the PUBLIC_ prefix — the Keystatic admin UI runs in the browser.
PUBLIC_KEYSTATIC_STORAGE=cloud
