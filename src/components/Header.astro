---
import Button from './Button.astro'
import Logo from './Logo.astro'
import { calAttrs, bookingHref } from '../lib/booking'
interface Props {
  practitionerName: string
  professionalTitle?: string
  logo?: string | null
}
const { practitionerName, professionalTitle, logo } = Astro.props
const nav = [
  { href: '/apie', label: 'Apie mane' },
  { href: '/kaip-vyksta', label: 'Kaip vyksta' },
  { href: '/kainos', label: 'Kainos' },
  { href: '/duk', label: 'D.U.K.' },
  { href: '/kontaktai', label: 'Kontaktai' },
]
const path = Astro.url.pathname
---
<header
  class="sticky top-0 z-30 border-b border-[var(--color-sand-200)] bg-[var(--color-sand-50)]/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-page items-center justify-between gap-6 px-6 py-5">
    <!-- Logo height is matched to the two-line text block beside it:
         The max-w caps exist because the mark is CMS-replaceable: a wide
         wordmark would otherwise push the name into the menu button on
         narrow screens. object-contain keeps any aspect ratio intact.
         name (leading-tight) + 2px gap + title (leading-snug).
         44px at base (20+2+12px type), 51px from md (24+2+14px type).
         Re-derive these if the lockup type sizes change. -->
    <a href="/" class="flex items-center gap-2.5 text-[var(--color-ink-900)]">
      <Logo
        src={logo}
        class="h-11 w-auto max-w-16 shrink-0 object-contain md:h-[3.2rem] md:max-w-40"
      />
      <span class="min-w-0">
        <span
          class="block font-serif text-xl leading-tight tracking-[-0.012em] whitespace-nowrap md:text-2xl"
        >
          {practitionerName}
        </span>
        {professionalTitle && (
          <span class="mt-0.5 block text-xs leading-snug text-[var(--color-ink-500)] md:text-sm">
            {professionalTitle}
          </span>
        )}
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Pagrindinis meniu">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class={`text-[0.95rem] transition-colors hover:text-[var(--color-clay-600)] ${
            path === item.href
              ? 'text-[var(--color-ink-900)]'
              : 'text-[var(--color-ink-500)]'
          }`}
        >
          {item.label}
        </a>
      ))}
      <Button booking variant="solid" class="ml-1 !px-5 !py-2.5 text-sm">
        Registruotis
      </Button>
    </nav>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded-sm border border-[var(--color-sand-300)] px-4 py-2 text-sm">
        Meniu
      </summary>
      <div class="absolute right-0 z-20 mt-3 w-56 rounded-2xl border border-[var(--color-sand-200)] bg-[var(--color-sand-50)] p-3 shadow-lg">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-xl px-3 py-2.5 hover:bg-[var(--color-sand-100)]">
            {item.label}
          </a>
        ))}
        <a
          href={bookingHref}
          class="mt-1 block rounded-xl bg-[var(--color-clay-500)] px-3 py-2.5 text-center text-white"
          {...calAttrs}
        >
          Registruotis
        </a>
      </div>
    </details>
  </div>
</header>
