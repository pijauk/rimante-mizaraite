---
interface Props {
  href: string
  variant?: 'primary' | 'quiet'
  class?: string
}
const { href, variant = 'primary', class: extra = '' } = Astro.props
const base =
  'inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-medium transition-colors duration-200 min-h-[48px]'
const styles =
  variant === 'primary'
    ? 'bg-[var(--color-clay-500)] text-white hover:bg-[var(--color-clay-600)]'
    : 'text-[var(--color-ink-700)] underline underline-offset-4 decoration-[var(--color-sand-300)] hover:decoration-[var(--color-clay-500)] px-0 py-0 min-h-0'
---
<a href={href} class={`${base} ${styles} ${extra}`}><slot /></a>
