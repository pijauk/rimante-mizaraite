---
/**
 * Cal.com element-click embed (their official snippet).
 *
 * Any element carrying the attributes from `calAttrs` opens the booking modal
 * on click — see src/lib/booking.ts. The triggers are real links to the
 * Cal.com booking page, so without JavaScript the visitor still reaches a
 * working calendar rather than a dead button.
 *
 * Note: this loads embed.js from app.cal.com on every page view, i.e. a
 * third-party request before the visitor has asked to book. Worth a line in
 * the privacy policy.
 */
import { calLink, calNamespace, calConfig } from '../lib/booking'
---
{calLink && calNamespace && (
  <script is:inline define:vars={{ calNamespace, calConfig }}>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", calNamespace, { origin: "https://app.cal.com" });
    Cal.config = Cal.config || {};
    Cal.config.forwardQueryParams = true;
    Cal.ns[calNamespace]("ui", {
      theme: calConfig.theme,
      hideEventTypeDetails: false,
      layout: calConfig.layout,
    });

    // Cal's own document click handler opens the modal but does NOT call
    // preventDefault (their docs assume the trigger is a <button>). Our
    // triggers are real <a href> links so the site works without JavaScript —
    // which means the browser would navigate away and tear the modal down as
    // it opens. Swallow the navigation ourselves, but only once Cal can
    // actually show the modal: if embed.js fails to load, the link must keep
    // working.
    document.addEventListener("click", (event) => {
      const trigger = event.target.closest("a[data-cal-link]");
      if (!trigger) return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
      if (!customElements.get("cal-modal-box")) return;
      event.preventDefault();
    });
  </script>
)}
