---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import { getPage } from '../lib/content'
import { render } from 'astro:content'

const page = await getPage('privacy')
const { Content } = await render(page!)
const d = page!.data
---
<Base title={d.seo?.title ?? 'Privatumo politika'} description={d.seo?.description}>
  <Section>
    <h1 class="text-4xl md:text-5xl">{d.heading}</h1>
    {d.lastUpdated && <p class="mt-3 text-sm text-[var(--color-ink-500)]">Atnaujinta: {d.lastUpdated}</p>}
    <div class="prose-measure prose-flow mt-10">
      <Content />
    </div>
  </Section>
</Base>
