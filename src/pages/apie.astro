---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import MediaBand from '../components/MediaBand.astro'
import { getPage } from '../lib/content'
import { render } from 'astro:content'

const page = await getPage('about')
const { Content } = await render(page!)
const d = page!.data
---
<Base title={d.seo?.title ?? 'Apie mane'} description={d.seo?.description}>
  <Section>
    <div class="grid gap-12 md:grid-cols-[1fr_1.3fr]">
      <div class="md:sticky md:top-28 md:self-start">
        {d.portrait ? (
          <img src={d.portrait} alt={d.portraitAlt ?? ''} width="640" height="800" class="w-full rounded-3xl object-cover" />
        ) : (
          <div class="flex aspect-[4/5] items-center justify-center rounded-3xl bg-[var(--color-sand-200)] text-sm text-[var(--color-ink-500)]">
            Vieta portretui
          </div>
        )}
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl">{d.heading}</h1>
        <div class="prose-measure prose-flow mt-8">
          <Content />
        </div>

        {d.qualifications.length > 0 && (
          <div class="mt-14">
            <h2 class="text-2xl md:text-3xl">Kvalifikacija</h2>
            <ul class="mt-6 divide-y divide-[var(--color-sand-200)] border-y border-[var(--color-sand-200)]">
              {d.qualifications.map((q) => (
                <li class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4">
                  <span class="text-[var(--color-ink-900)]">{q.title}</span>
                  <span class="text-sm text-[var(--color-ink-500)]">{q.institution} {q.year}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-12"><Button href="/registracija">Nemokamas 15 min. pokalbis</Button></div>
      </div>
    </div>
  </Section>

  <MediaBand src={d.roomImage} alt={d.roomImageAlt} label="Vieta kabineto nuotraukai" />
</Base>
