---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
---
<Base title="Puslapis nerastas" description="Tokio puslapio nėra.">
  <Section>
    <div class="prose-measure">
      <h1 class="text-4xl md:text-5xl">Puslapis nerastas</h1>
      <p class="mt-6 text-[var(--color-ink-500)]">
        Atsiprašome — tokio puslapio nėra. Galbūt ieškote registracijos?
      </p>
      <div class="mt-9"><Button href="/">Į pradžią</Button></div>
    </div>
  </Section>
</Base>
