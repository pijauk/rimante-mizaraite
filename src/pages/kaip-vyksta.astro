---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import { getPage, getServices } from '../lib/content'
import { render } from 'astro:content'

const page = await getPage('approach')
const { Content } = await render(page!)
const d = page!.data
const services = await getServices()
---
<Base title={d.seo?.title ?? 'Kaip vyksta konsultacijos'} description={d.seo?.description}>
  <Section>
    <h1 class="text-4xl">{d.heading}</h1>
    <p class="prose-measure mt-6 text-lg text-[var(--color-ink-500)]">{d.intro}</p>
    <div class="prose-measure mt-10 space-y-5 [&_h2]:mt-10 [&_h2]:text-2xl">
      <Content />
    </div>
  </Section>

  <Section tone="raised">
    <h2 class="text-3xl">{d.firstSessionHeading}</h2>
    <p class="prose-measure mt-5 text-[var(--color-ink-500)]">{d.firstSessionText}</p>
    <div class="mt-9"><Button href="/registracija">Registruotis pokalbiui</Button></div>
  </Section>

  <Section>
    <h2 class="text-3xl">Konsultacijų tipai</h2>
    <div class="mt-10 space-y-8">
      {services.map((s) => (
        <div class="border-t border-[var(--color-sand-200)] pt-6">
          <h3 class="text-xl">{s.data.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-ink-500)]">
            {s.data.duration} · {s.data.price}
            {s.data.forNewClients && <span class="ml-2">· galima registruotis internetu</span>}
          </p>
        </div>
      ))}
    </div>
  </Section>
</Base>
