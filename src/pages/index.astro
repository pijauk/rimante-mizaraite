---
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import MediaBand from '../components/MediaBand.astro'
import { homeContent as page, getServices, getFaq } from '../lib/content'
import { render } from 'astro:content'

const services = await getServices()
const faqAll = await getFaq()
const faq = await Promise.all(
  faqAll.slice(0, 4).map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
)
---
<Base
  title={page.seo?.title ?? 'Psichoterapija'}
  description={page.seo?.description}
  image={page.heroImage || undefined}
>
  <section class="hero">
    <div class="hero-copy">
      <h1 class="text-4xl sm:text-5xl md:text-6xl">{page.heroHeading}</h1>
      <p class="prose-measure mt-7 text-lg text-[var(--color-ink-500)]">{page.heroIntro}</p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <Button href="/registracija">Nemokamas 15 min. pokalbis</Button>
        <Button href="/kontaktai" variant="quiet">Turite klausimų?</Button>
      </div>
    </div>

    <div class="hero-media">
      {page.heroImage ? (
        <img
          src={page.heroImage}
          alt={page.heroImageAlt ?? ''}
          width="900"
          height="1100"
          fetchpriority="high"
          class="media-fill max-md:aspect-[4/3]"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-[var(--color-sand-200)] text-sm text-[var(--color-ink-500)] max-md:aspect-[4/3]"
        >
          Vieta nuotraukai
        </div>
      )}
    </div>
  </section>

  <Section tone="raised">
    <h2 class="text-3xl md:text-4xl">{page.helpWithHeading}</h2>
    <div class="mt-12 grid gap-x-14 gap-y-12 sm:grid-cols-2">
      {page.helpWith.map((item) => (
        <div>
          <h3 class="text-2xl">{item.title}</h3>
          <p class="mt-4 text-[var(--color-ink-500)]">{item.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-3xl md:text-4xl">Konsultacijos ir kainos</h2>
      <a href="/kainos" class="text-[var(--color-ink-500)] underline underline-offset-4 hover:text-[var(--color-clay-600)]">
        Visos kainos
      </a>
    </div>
    <dl class="mt-10 divide-y divide-[var(--color-sand-200)] border-y border-[var(--color-sand-200)]">
      {services.map((s) => (
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5">
          <dt class="text-lg text-[var(--color-ink-900)]">{s.data.title}</dt>
          <dd class="text-[var(--color-ink-500)]">
            <span class="mr-4">{s.data.duration}</span>
            <span class="text-[var(--color-ink-900)]">{s.data.price}</span>
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section tone="raised">
    <h2 class="text-3xl md:text-4xl">Dažniausiai užduodami klausimai</h2>
    <div class="mt-10 divide-y divide-[var(--color-sand-200)] border-y border-[var(--color-sand-200)]">
      {faq.map(({ entry, Content }) => (
        <details class="py-5">
          <summary class="cursor-pointer list-none text-lg text-[var(--color-ink-900)]">
            {entry.data.question}
          </summary>
          <div class="prose-measure prose-flow mt-3 [--flow-gap:1rem] text-[var(--color-ink-500)]"><Content /></div>
        </details>
      ))}
    </div>
    <p class="mt-8">
      <a href="/duk" class="underline underline-offset-4 hover:text-[var(--color-clay-600)]">Visi klausimai</a>
    </p>
  </Section>

  <MediaBand src={page.midImage} alt={page.midImageAlt} />

  <Section>
    <div class="prose-measure">
      <h2 class="text-3xl md:text-4xl">{page.closingHeading}</h2>
      <p class="mt-5 text-[var(--color-ink-500)]">{page.closingText}</p>
      <div class="mt-9"><Button href="/registracija">Nemokamas 15 min. pokalbis</Button></div>
    </div>
  </Section>
</Base>
